# Database Connection (Neon Postgres Serverless)
DATABASE_URL=postgresql://neondb_owner:password@ep-your-database.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# App URL
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Auth Secrets (32+ chars random string)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters

# Node Environment
NODE_ENV=production
